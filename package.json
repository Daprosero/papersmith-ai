{
  "name": "papersmith-ai",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Papersmith AI — native OpenCode skills for paper ingestion and paper-proposal.",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "test": "DELIBERATION_DOMAIN_PROFILE=$PWD/.opencode/skills/proposal-deliberation/profile.ts node --test \"tests/**/*.mjs\"",
    "test:node": "DELIBERATION_DOMAIN_PROFILE=$PWD/.opencode/skills/proposal-deliberation/profile.ts node --test \"tests/**/*.mjs\"",
    "test:py": ".micromamba/envs/papersmith/bin/pytest",
    "test:all": "pnpm run test:node && pnpm run test:py",
    "setup": "pnpm install && python scripts/setup_env.py install",
    "proposal-deliberation": "node .opencode/skills/proposal-deliberation/cli.mjs",
    "setup:env": "python scripts/setup_env.py install",
    "clean:env": "python scripts/setup_env.py clean",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "jiti": "^2.4.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
