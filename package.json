{
  "name": "papersmith-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Papersmith AI — native Claude Code skills for paper ingestion and paper-proposal.",
  "scripts": {
    "test": "DELIBERATION_DOMAIN_PROFILE=$PWD/skills/proposal-deliberation/profile.ts node --test \"tests/**/*.mjs\"",
    "test:node": "DELIBERATION_DOMAIN_PROFILE=$PWD/skills/proposal-deliberation/profile.ts node --test \"tests/**/*.mjs\"",
    "test:py": ".micromamba/envs/papersmith/bin/pytest",
    "test:all": "npm run test:node && npm run test:py",
    "setup": "npm install && python3 scripts/setup_env.py install && bash scripts/setup-harnesses.sh",
    "proposal-deliberation": "node skills/proposal-deliberation/cli.mjs",
    "setup:harnesses": "bash scripts/setup-harnesses.sh",
    "setup:env": "python3 scripts/setup_env.py install",
    "clean:env": "python3 scripts/setup_env.py clean",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "jiti": "^2.4.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
