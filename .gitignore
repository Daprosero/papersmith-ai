# Local Pi runtime state
.atl/
.DS_Store
research-concept-r02(1).md
research-concept-r02(1) 2.md
.codegraph/
.gga
# Node dependencies
node_modules/

# Paper-ingestion (Marker) local environment and model cache
.claude/skills/paper-ingestion/.venv/

# --- Contenido específico de cada usuario ---
# Versionamos solo el scaffold de carpetas (los `.gitkeep`); cada usuario arma
# el suyo: agrega sus PDFs, los ingiere, delibera con el tutor, y todo eso
# genera sus propios archivos. No se publican los del autor original.

# Papers guía y de referencia: PDFs, Markdown ingerido, figuras.
# Por carpeta, no por nombre: la ingesta descubre sus raíces bajo `guidance/` en
# cada corrida, así que una carpeta nueva ya queda cubierta sin tocar esto. Si se
# nombraran una por una, la primera raíz nueva publicaría sus PDFs y figuras.
guidance/*/*
!guidance/*/.gitkeep

# Propuestas gestionadas y su estado interno del motor
proposals/*
!proposals/.gitkeep

# Repos destino de proposal-implementation: cada uno trae su propio .git y su propio
# .venv. Ignorarlos evita gitlinks accidentales en el índice de la forja y que
# el entorno del destino se mezcle con el de marker.
implementations/*
!implementations/.gitkeep

# Pesos de modelos usados solo para pruebas locales de proposal-implementation: se
# copian al repo destino tras clonarlo para no volver a descargarlos por LFS.
# Es material de prueba del usuario, no un artefacto de la forja.
Models/
.proposal-deliberation/
.paper-proposal-v2/

# Copias de respaldo de reconciliación de base
backup/

# Caché de bytecode de Python
__pycache__/


# Fuente de la propuesta: contenido de investigación, nunca se versiona.
# El glob cubre los duplicados que crea Finder ("Target 2.md"), que son copias
# byte a byte y quedaban fuera de una regla con el nombre exacto.
Target*.md

# Permisos locales de Claude Code: rutas de máquina y comandos de una sesión
.claude/settings.json

# Material de referencia externo clonado para estudio: se lee, se destila y se
# borra. Nunca se versiona código de terceros dentro de la forja.
tmp-reference/

# Local interpreter environments (never versioned; rebuild from requirements.txt)
.venv/
