{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papersmith.ai/schemas/papersmith-manifest-v1.1.schema.json",
  "title": "Papersmith normalized-paper manifest v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "source_pdf",
    "source_sha256",
    "processed_at",
    "renderer",
    "render_dpi",
    "page_count",
    "pages",
    "review_required_pages",
    "confidence_threshold",
    "confidence_method",
    "extraction_configuration",
    "configuration_path",
    "equations",
    "figures",
    "tables"
  ],
  "properties": {
    "$schema": {"const": "https://papersmith.ai/schemas/papersmith-manifest-v1.1.schema.json"},
    "schema_version": {"const": "1.1"},
    "source_pdf": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "processed_at": {"type": "string", "format": "date-time"},
    "renderer": {"const": "PyMuPDF"},
    "render_dpi": {"type": "integer", "minimum": 1},
    "page_count": {"type": "integer", "minimum": 0},
    "pages": {
      "type": "array",
      "items": {"$ref": "#/$defs/page"}
    },
    "review_required_pages": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence_method": {"type": "string", "minLength": 1},
    "extraction_configuration": {"$ref": "#/$defs/extractionConfiguration"},
    "configuration_path": {"type": ["string", "null"]},
    "equations": {
      "type": "array",
      "items": {"$ref": "#/$defs/equation"}
    },
    "figures": {
      "type": "array",
      "items": {"$ref": "#/$defs/figure"}
    },
    "tables": {"$ref": "#/$defs/tables"}
  },
  "$defs": {
    "pageProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "page_image"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "page_image": {"type": "string", "minLength": 1}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "image",
        "raw_text",
        "text_characters",
        "confidence",
        "confidence_status",
        "confidence_notes",
        "textual_figure_captions",
        "equation_ids",
        "figure_ids"
      ],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "image": {"type": "string", "minLength": 1},
        "raw_text": {"type": "string"},
        "text_characters": {"type": "integer", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_status": {"enum": ["acceptable", "review_required"]},
        "confidence_notes": {"type": "string", "minLength": 1},
        "textual_figure_captions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "equation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^page-[0-9]{3}-equation-[0-9]{3}$"}
        },
        "figure_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^page-[0-9]{3}-image-[0-9]{3}$"}
        }
      }
    },
    "extractionConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "figures", "tables", "equations"],
      "properties": {
        "text": {"type": "boolean"},
        "figures": {"type": "boolean"},
        "tables": {"type": "boolean"},
        "equations": {"type": "boolean"}
      }
    },
    "equation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "raw_text", "provenance", "confidence", "status", "review_required"],
      "properties": {
        "id": {"type": "string", "pattern": "^page-[0-9]{3}-equation-[0-9]{3}$"},
        "raw_text": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/pageProvenance"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["raw_text_preserved", "review_required"]},
        "review_required": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"review_required": {"const": true}}, "required": ["review_required"]},
          "then": {"properties": {"status": {"const": "review_required"}}},
          "else": {"properties": {"status": {"const": "raw_text_preserved"}}}
        }
      ]
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provenance", "metadata", "confidence", "status", "review_required"],
      "properties": {
        "id": {"type": "string", "pattern": "^page-[0-9]{3}-image-[0-9]{3}$"},
        "provenance": {"$ref": "#/$defs/pageProvenance"},
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["xref", "smask", "width", "height", "bits_per_component", "colorspace"],
          "properties": {
            "xref": {"type": "integer", "minimum": 0},
            "smask": {"type": "integer", "minimum": 0},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1},
            "bits_per_component": {"type": "integer", "minimum": 1},
            "colorspace": {"type": ["integer", "string"]}
          }
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"const": "review_required"},
        "review_required": {"const": true}
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode", "evidence", "review_required"],
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"enum": ["lite_evidence_only", "disabled"]},
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["exact_raw_page_text", "rendered_page_images"]}
        },
        "review_required": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
          "then": {
            "properties": {
              "mode": {"const": "lite_evidence_only"},
              "evidence": {
                "const": ["exact_raw_page_text", "rendered_page_images"]
              },
              "review_required": {"const": true}
            }
          },
          "else": {
            "properties": {
              "mode": {"const": "disabled"},
              "evidence": {"const": []},
              "review_required": {"const": false}
            }
          }
        }
      ]
    }
  }
}
